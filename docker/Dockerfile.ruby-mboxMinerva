# Dockerfile for mboxMinerva
# -----------------------------------------------------------------------------
# mboxMinerva CI/CD Container - Ruby 3.4.7 (Debian Trixie/Bookworm)
# -----------------------------------------------------------------------------
FROM docker.io/library/ruby:3.4.7-slim
ARG GIT_COMMIT=unknown
ENV GIT_COMMIT=${GIT_COMMIT}

# 1. Install System Dependencies
#    - git: Missing from slim, needed for gemspecs and git-crypt
#    - build-essential: Needed for compiling pg and simhash native extensions
#    - libpq-dev: Needed for pg header files
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    libpq-dev \
    gnupg \
    libyaml-dev \
    zlib1g-dev \
    libicu-dev \
    && rm -rf /var/lib/apt/lists/*

# 2. Prepare App Directory
WORKDIR /mboxMinerva

# 3. Dependency Layer Caching
#    Copy only the dependency manifests first.
#    This ensures 'bundle install' runs only when Gemfile changes, not code.
COPY Gemfile Gemfile.lock ./

# 4. Specify the env var to override the mounted .bundle/config specified one.
#    We have .bundle/ listed within .gitignore. Docker can't copy what is not committed to the repo. Same with respect to 
#    `vendor/bundle`. So trying to `COPY Gemfile Gemfile.lock .bundle ./` is futile.
#    At build time this directive doesn't change the default. But at runtime (which does), instead of the bind-mount bringing in 
#    `.bundle/config` and bundler looking within an empty `vendor/bundle`, this env variable overrides the mounted `.bundle/config` and
#    makes Bundler look where the gems actually are located within the container.  
ENV BUNDLE_PATH=/usr/local/bundle

# 5. Install Ruby Dependencies
RUN bundle install

# 6. Runtime Configuration
#    We DO NOT copy source code here (./lib, ./bin).
#    It is bind-mounted at runtime on the gitlab-runner: podman run -v /home/dmr104/ruby_projects/mboxMinerva:/mboxMinerva ...
CMD ["/bin/bash"]
